# ── Node.js ──────────────────────────────────────────────────────────────────

# Installed packages — never commit these. Anyone cloning the repo runs
# 'npm install' to restore them from package.json + package-lock.json.
node_modules/

# ── TypeScript Build Output ───────────────────────────────────────────────────

# Compiled JavaScript output — generated from source, not source itself.
# The source of truth is the .ts files in src/. dist/ is regenerated on build.
dist/

# ── Environment Variables ─────────────────────────────────────────────────────

# .env contains secrets (API keys, DB passwords) — NEVER commit this.
# Use .env.example as a template (committed, but with no real values).
.env
.env.local
.env.*.local

# ── Logs ─────────────────────────────────────────────────────────────────────

logs/
*.log
npm-debug.log*

# ── OS / Editor ───────────────────────────────────────────────────────────────

.DS_Store
Thumbs.db
.vscode/settings.json

# ── Uploads ──────────────────────────────────────────────────────────────────

# User-uploaded files (added in Phase 8)
uploads/

# ── Test Coverage ─────────────────────────────────────────────────────────────

# Generated by Vitest (Phase 13)
coverage/

/src/generated/prisma
.claude/
