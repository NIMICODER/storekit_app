{
	"info": {
		"name": "StoreKit API — Phase 9",
		"description": "Full e-commerce API with auth, caching, and file uploads.\n\nBase URL: http://localhost:3000/api/v1\n\nSetup:\n1. `npm run dev`\n2. `npm run db:seed` (first time)\n3. Use \"Login as Admin (auto-save)\" to get tokens\n4. Protected routes use {{accessToken}} automatically",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:3000/api/v1"
		},
		{
			"key": "accessToken",
			"value": ""
		},
		{
			"key": "refreshToken",
			"value": ""
		},
		{
			"key": "productId",
			"value": "PASTE_PRODUCT_ID_HERE"
		},
		{
			"key": "categoryId",
			"value": "PASTE_CATEGORY_ID_HERE"
		},
		{
			"key": "userId",
			"value": "PASTE_USER_ID_HERE"
		}
	],
