# .env.example — Environment Variable Template
#
# This file IS committed to git. It serves as documentation:
# "Here are all the environment variables this app needs."
#
# How to use:
#   cp .env.example .env
#   Then fill in real values in .env
#
# Variables marked REQUIRED must be set. Optional ones have defaults in code.

# ── App ───────────────────────────────────────────────────────────────────────

NODE_ENV=development           # development | production | test
PORT=3000                      # HTTP server port
API_VERSION=v1                 # API route prefix

# ── Database (Phase 3) ────────────────────────────────────────────────────────

# REQUIRED — PostgreSQL connection string
# Create the database first: CREATE DATABASE storekit_db;
DATABASE_URL=postgresql://postgres:password@localhost:5432/storekit_db?schema=public

# ── Redis (Phase 9) ──────────────────────────────────────────────────────────

# Optional — Redis connection URL for caching (default: redis://localhost:6379)
# REDIS_URL=redis://localhost:6379

# Optional — Default cache TTL in seconds (default: 3600 = 1 hour)
# CACHE_TTL=3600

# ── Auth (Phase 6) ────────────────────────────────────────────────────────

# REQUIRED — Secret key for signing access tokens (min 32 chars, random)
JWT_SECRET=your-super-secret-key-change-me-min-32-chars

# Optional — Access token expiry (default: 15m)
JWT_EXPIRY=15m

# REQUIRED — Separate secret for refresh tokens (min 32 chars, random)
JWT_REFRESH_SECRET=another-super-secret-key-change-me-min-32-chars

# Optional — Refresh token expiry (default: 7d)
JWT_REFRESH_EXPIRY=7d

# Optional — Bcrypt salt rounds (default: 10, higher = slower but safer)
# BCRYPT_ROUNDS=10

# ── File Uploads (Phase 8) ────────────────────────────────────────────────────

# Optional — Directory for storing uploaded files (default: ./uploads)
# UPLOAD_DIR=./uploads

# Optional — Maximum file size in bytes (default: 5242880 = 5MB)
# MAX_FILE_SIZE=5242880

# Optional — Comma-separated list of allowed MIME types for image uploads
# ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# ── Background Jobs / BullMQ (Phase 10) ──────────────────────────────────────

# Optional — IORedis URL for BullMQ (defaults to REDIS_URL, then redis://localhost:6379)
# BullMQ uses IORedis, a different Redis driver from the cache client (node-redis v5).
# BULL_REDIS_URL=redis://localhost:6379

# Optional — Max retry attempts per job (default: 3)
# BULL_MAX_RETRIES=3

# Optional — Base backoff delay in ms (doubles each retry) (default: 1000)
# BULL_RETRY_BACKOFF=1000

# Optional — Number of jobs processed concurrently per worker (default: 5)
# BULL_CONCURRENCY=5

# Optional — Products with stock at or below this trigger a low-stock alert (default: 10)
# LOW_STOCK_THRESHOLD=10

# Optional — Carts inactive for this many hours are considered abandoned (default: 24)
# ABANDONED_CART_HOURS=24

# ── Email / SMTP (Phase 10) ─────────────────────────────────────────────────

# Optional — SMTP host. If not set, uses Ethereal (fake SMTP for development).
# For production, use SendGrid, AWS SES, Mailgun, etc.
# SMTP_HOST=smtp.sendgrid.net

# Optional — SMTP port (default: 587). Use 465 for SSL, 587 for STARTTLS.
# SMTP_PORT=587

# Optional — SMTP username (often an API key for services like SendGrid)
# SMTP_USER=apikey

# Optional — SMTP password (or API key value)
# SMTP_PASS=your-smtp-password

# Optional — Sender address for all outgoing emails
# EMAIL_FROM=StoreKit <noreply@storekit.dev>

# ── Webhooks (Phase 11) ───────────────────────────────────────────────────────

# Optional — HMAC-SHA256 secret for verifying incoming webhooks from payment providers.
# Must match the secret configured in your Paystack/Stripe dashboard.
# Default: a dummy secret (fine for development, MUST change in production!)
# WEBHOOK_SECRET=storekit-webhook-secret-change-me-in-production

# Optional — Payment provider name (used for logging/labelling, not API calls in dev)
# PAYMENT_PROVIDER=mock

# ── Rate Limiting (Phase 12) ─────────────────────────────────────────────────

# Optional — Global rate limit window in milliseconds (default: 900000 = 15 minutes)
# RATE_LIMIT_WINDOW_MS=900000

# Optional — Maximum requests per window per IP (default: 100)
# Auth routes use 10/window; checkout uses 20/window (hardcoded in middleware)
# RATE_LIMIT_MAX=100

# ── CORS (for production) ─────────────────────────────────────────────────────

# ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
