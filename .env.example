# .env.example — Environment Variable Template
#
# This file IS committed to git. It serves as documentation:
# "Here are all the environment variables this app needs."
#
# How to use:
#   cp .env.example .env
#   Then fill in real values in .env
#
# Variables marked REQUIRED must be set. Optional ones have defaults in code.

# ── App ───────────────────────────────────────────────────────────────────────

NODE_ENV=development           # development | production | test
PORT=3000                      # HTTP server port
API_VERSION=v1                 # API route prefix

# ── Database (Phase 3) ────────────────────────────────────────────────────────

# REQUIRED — PostgreSQL connection string
# Create the database first: CREATE DATABASE storekit_db;
DATABASE_URL=postgresql://postgres:password@localhost:5432/storekit_db?schema=public

# ── Redis (added in Phase 9) ──────────────────────────────────────────────────

# REDIS_URL=redis://localhost:6379

# ── Auth (Phase 6) ────────────────────────────────────────────────────────

# REQUIRED — Secret key for signing access tokens (min 32 chars, random)
JWT_SECRET=your-super-secret-key-change-me-min-32-chars

# Optional — Access token expiry (default: 15m)
JWT_EXPIRY=15m

# REQUIRED — Separate secret for refresh tokens (min 32 chars, random)
JWT_REFRESH_SECRET=another-super-secret-key-change-me-min-32-chars

# Optional — Refresh token expiry (default: 7d)
JWT_REFRESH_EXPIRY=7d

# Optional — Bcrypt salt rounds (default: 10, higher = slower but safer)
# BCRYPT_ROUNDS=10

# ── File Uploads (Phase 8) ────────────────────────────────────────────────────

# Optional — Directory for storing uploaded files (default: ./uploads)
# UPLOAD_DIR=./uploads

# Optional — Maximum file size in bytes (default: 5242880 = 5MB)
# MAX_FILE_SIZE=5242880

# Optional — Comma-separated list of allowed MIME types for image uploads
# ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# ── CORS (for production) ─────────────────────────────────────────────────────

# ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
